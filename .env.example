# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API Keys.
# Never commit real values.

# Public (inlined into the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only — bypasses RLS
SUPABASE_SECRET_KEY=sb_secret_...

# AI marketing manager (server-side only). Keh uses the first key that's set:
# Gemini, then OpenAI. With neither, it runs a built-in guided mode.
# Gemini has a free tier — get a key at https://aistudio.google.com/apikey
# (free-tier prompts may be used by Google to improve its products).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded or out of quota:
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash
# How much the model "thinks" (billed as output): minimal | low | medium | high.
# "minimal" is cheapest but isn't available on Pro models.
# GEMINI_THINKING_LEVEL=low

# Optional alternative
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Meta app (Facebook Pages + Instagram) — https://developers.facebook.com/apps
# Add <your site>/auth/social/callback as a Valid OAuth Redirect URI.
META_APP_ID=
META_APP_SECRET=

# Posting to Facebook / Instagram and collecting their metrics. Not part of the MVP:
# leave false and "Schedule" / "Publish now" only save posts to the calendar.
PUBLISHING_ENABLED=false

# Encrypts Facebook / Instagram tokens at rest (required to connect them).
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later means owners have to reconnect their accounts.
SOCIAL_TOKEN_KEY=

# Scheduled publishing and metrics (pg_cron → /api/cron/*, migration 016). Only needed
# once the app is deployed and PUBLISHING_ENABLED=true.
# At least 16 random characters; store the same value in Supabase Vault as keh_cron_secret.
CRON_SECRET=
