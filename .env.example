# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API Keys.
# Never commit real values.

# Public (inlined into the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only — bypasses RLS
SUPABASE_SECRET_KEY=sb_secret_...

# Optional — enables model-powered Keh marketing advice (server-side only).
# Without a key, Keh uses a transparent guided mode based on the business profile.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
